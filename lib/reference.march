mod CryptoReference do
  opaque type Reference = ChainReference(CryptoIdentity.Network, String, String) | ExchangeReference(String, String, String)

  fn on_chain(n : CryptoIdentity.Network, transaction_id : String, event_id : String) : Result(Reference, CryptoError.Error) do
    if CryptoIdentity.valid_id(transaction_id) && CryptoIdentity.valid_id(event_id) do Ok(ChainReference(n, transaction_id, event_id))
    else Err(CryptoError.InvalidId) end
  end
  fn exchange(venue : String, account_scope : String, event_id : String) : Result(Reference, CryptoError.Error) do
    if CryptoIdentity.valid_id(venue) && CryptoIdentity.valid_id(account_scope) && CryptoIdentity.valid_id(event_id) do
      Ok(ExchangeReference(venue, account_scope, event_id))
    else Err(CryptoError.InvalidId) end
  end
  fn network(r : Reference) : Option(CryptoIdentity.Network) do
    match r do
      ChainReference(n, _, _) -> Some(n)
      ExchangeReference(_, _, _) -> None
    end
  end
  fn key(r : Reference) : String do
    match r do
      ChainReference(n, tx, event) -> "finance-crypto:v1:chain:" ++ CryptoIdentity.component(CryptoIdentity.network_id(n)) ++ CryptoIdentity.component(tx) ++ CryptoIdentity.component(event)
      ExchangeReference(venue, account, event) -> "finance-crypto:v1:exchange:" ++ CryptoIdentity.component(venue) ++ CryptoIdentity.component(account) ++ CryptoIdentity.component(event)
    end
  end
  fn metadata(r : Reference, source : String, effective : Int, recorded : Int) : Result(FinanceMetadata.Metadata, CryptoError.Error) do
    Result.map_err(FinanceMetadata.make(source, effective, recorded, Some(key(r))), fn e -> CryptoError.Core(e))
  end
end
